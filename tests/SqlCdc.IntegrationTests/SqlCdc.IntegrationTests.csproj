<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One framework is enough here: these tests exercise SQL Server behaviour, not the
         library's framework targeting, and every run costs a container. -->
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testcontainers pulls in SSH.NET for its port forwarding, and its latest release still
         resolves to a version with a published advisory. It never leaves the test host and is
         not part of the shipped package; revisit when Testcontainers updates the dependency. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-q939-rpr3-3284" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SqlCdc\SqlCdc.csproj" />
  </ItemGroup>

</Project>
